Optional hpijs-style job stream for pcl3gui2 printers.

HP's hpcups was never what HP tested the older PCL3GUI printers with (the
DJ9xxVIP / Photosmart A-series "PSP470" class); those shipped with hpijs.
hpcups' Pcl3Gui2 encapsulator formats the job differently in several ways,
and at least the Photosmart A620 prints solid black when given it, while a
stream from hpijs prints correctly.  This patch adds two PPD attributes:

  *HPCrdType: "both"        send hpijs' two-component K + sRGB raster
                            descriptor (crd "06 1F 00 02 ...") and an empty
                            black plane with each row, instead of sRGB only.

  *HPLegacyPcl3Gui2: True   everything above, plus: a Configure Image Data
                            command (Esc*v6W, RGB / 8 bits per primary),
                            print quality capped at 1 (hpijs never sent 2),
                            no Esc*t#R raster-resolution command, an
                            absolute cursor position (Esc*p#Y) before every
                            row, Esc*b0Y after a skipped blank run so the
                            printer resets its Mode 10 seed row, and a page
                            ending in a bare form feed (no Esc*rC).

Without either attribute the filter's output is unchanged.

--- a/prnt/hpcups/CommonDefinitions.h
+++ b/prnt/hpcups/CommonDefinitions.h
@@ -465,6 +465,8 @@
     int                printer_platform_version;
     int                pre_process_raster;
     int                HPSPDClass;
+    int                crd_both;      /* PPD *HPCrdType: "both" -- send the K+sRGB (KRGB) CRD and a (empty) K plane per row */
+    int                legacy_pcl3gui2; /* PPD *HPLegacyPcl3Gui2: True -- format the whole job the way hpijs (DJ9xxVIP) did */
     int 	       args_duplex_mode;
 } JobAttributes;
 
--- a/prnt/hpcups/HPCupsFilter.cpp
+++ b/prnt/hpcups/HPCupsFilter.cpp
@@ -409,6 +409,25 @@
     {
         m_JA.HPSPDClass = atoi(attr->value);
     }
+
+    // Older PCL3GUI printers (e.g. Photosmart A/PSP470 class) were driven by
+    // hpijs with a two-component K+sRGB raster descriptor.  Pcl3Gui2 always
+    // declares sRGB only; let a PPD ask for the hpijs-style descriptor.
+    m_JA.crd_both = 0;
+    if ((attr = ppdFindAttr(m_ppd, "HPCrdType", NULL)) != NULL &&
+        attr->value != NULL && !strcasecmp(attr->value, "both"))
+    {
+        m_JA.crd_both = 1;
+    }
+    // Go further and mimic hpijs' DJ9xxVIP job stream: KRGB descriptor, a
+    // Configure Image Data command, quality capped at 1, no raster
+    // resolution command, and an absolute cursor position before each row.
+    m_JA.legacy_pcl3gui2 = 0;
+    if ((attr = ppdFindAttr(m_ppd, "HPLegacyPcl3Gui2", NULL)) != NULL &&
+        attr->value != NULL && (!strcasecmp(attr->value, "true") || !strcmp(attr->value, "1")))
+    {
+        m_JA.legacy_pcl3gui2 = 1;
+    }
     
 
