+DRIVER_ERROR Pcl3Gui2::SendCAPy(int iOffset)
+{
+    if (m_legacy) {
+        // Rows carry an absolute position, so the skip itself is bookkeeping,
+        // but the Mode 10 seed row was reset on our side (Mode10::Flush) and
+        // the printer must reset its copy too: hpijs sent Esc*b0Y for that.
+        m_cur_row += iOffset;
+        return this->Send((const BYTE *) "\033*b0Y", 5);
+    }
+    return Encapsulator::SendCAPy(iOffset);
+}
+
+DRIVER_ERROR Pcl3Gui2::FormFeed()
+{
+    if (m_legacy) {
+        // hpijs ended the page with a bare form feed, no Esc*rC.
+        return this->Send((const BYTE *) "\x0C", 1);
+    }
+    return Encapsulator::FormFeed();
+}
+
 DRIVER_ERROR Pcl3Gui2::Encapsulate(RASTERDATA *InputRaster, bool bLastPlane)
 {
-    DRIVER_ERROR    err;
+    DRIVER_ERROR    err = NO_ERROR;
+    if (m_legacy) {
+        char    szPos[16];
+        int     n = sprintf(szPos, "\033*p%dY", m_cur_row++);
+        err = this->Send((const BYTE *) szPos, n);
+        if (err != NO_ERROR) {
+            return err;
+        }
+    }
     if (crd_type != eCrd_color_only) {
         err = encapsulateRaster(InputRaster->rasterdata[COLORTYPE_BLACK], InputRaster->rastersize[COLORTYPE_BLACK], COLORTYPE_BLACK);
     }
